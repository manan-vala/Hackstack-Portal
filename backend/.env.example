# MongoDB — Option A: Atlas (whitelist your IP in Atlas → Network Access)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/hackstack?retryWrites=true&w=majority

# MongoDB — Option B: local Docker (from backend/: docker compose up -d)
# MONGO_URI=mongodb://127.0.0.1:27017/hackstack

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Admin login credentials for /api/auth/admin/login
ADMIN_USERNAME=
ADMIN_PASSWORD=

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Frontend URL (OAuth redirect target)
FRONTEND_URL=http://localhost:5173

# Optional: override OAuth callback base (defaults to FRONTEND_URL)
# GitHub app must register: http://localhost:5173/api/auth/github/callback
OAUTH_CALLBACK_URL=http://localhost:5173

# Server Port
PORT=5000
